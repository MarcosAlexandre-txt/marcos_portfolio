---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { skillEvidenceLink } from '../data/evidence';
import skillCard from '../../assets/plates/skill-card.png';
import { academicProjects, personalProjects, skillArcanas, interests, semesters, currentSemester, certifications } from '../data/portfolio';
import heroProfile from '../../assets/plates/hero-epic.png';
import train from '../../assets/plates/about-epic.png';
import classroom from '../../assets/plates/formation-epic.png';
import skillsArt from '../../assets/plates/skills-observatory.png';
import projectsArt from '../../assets/plates/projects-engraving.png';
import contactArt from '../../assets/plates/contact-engraving.png';
const [heroProfileView,trainView,classroomView,skillsArtView,projectsArtView,contactArtView] = await Promise.all([
  getImage({src:heroProfile,format:'webp',quality:86}),
  getImage({src:train,format:'webp',quality:88}),
  getImage({src:classroom,format:'webp',quality:88}),
  getImage({src:skillsArt,format:'webp',quality:85}),
  getImage({src:projectsArt,format:'webp',quality:82}),
  getImage({src:contactArt,format:'webp',quality:82}),
]);
const cardArt = await getImage({src:skillCard,format:'webp',quality:96});
const fronts = import.meta.glob('../../assets/skill-fronts/*.webp', {eager:true, query:'?url', import:'default'}) as Record<string,string>;
const cardFront = (i:number) => fronts[`../../assets/skill-fronts/${String(i).padStart(2,'0')}.webp`];
const frontSources = import.meta.glob('../../assets/skill-fronts/*.webp', {eager:true, import:'default'}) as Record<string,ImageMetadata>;
const cardThumbs = await Promise.all(skillArcanas.map((_,i)=>getImage({
  src:frontSources[`../../assets/skill-fronts/${String(i).padStart(2,'0')}.webp`],
  width:96,format:'webp',quality:84,
})));
const sections = [{id:'sobre',name:'Sobre'}, {id:'projetos',name:'Projetos'}, {id:'formacao',name:'Formação'}, {id:'skills',name:'Skills'}, {id:'contato',name:'Contato'}];
const now = semesters.indexOf(currentSemester);
const channels = [
  {name:'E-mail', value:'marcos.alexandre.scrt@gmail.com', href:'mailto:marcos.alexandre.scrt@gmail.com', external:false},
  {name:'LinkedIn', value:'marcos-alexandre-cs', href:'https://www.linkedin.com/in/marcos-alexandre-cs', external:true},
  {name:'GitHub', value:'MarcosAlexandre-txt', href:'https://github.com/MarcosAlexandre-txt', external:true},
];
---
<div class="section-views">
  {sections.map(section=><section class:list={['section-view',`view-${section.id}`]} id={section.id} aria-labelledby={`${section.id}-title`}>
    <nav class="view-bar" aria-label="Trocar de seção">
      <a class="view-back" href="#inicio"><kbd>Esc</kbd>Menu</a>
      <ul>{sections.map(item=><li><a href={`#${item.id}`} aria-current={item.id===section.id?'page':undefined}>{item.name}</a></li>)}</ul>
    </nav>
    {section.id==='projetos'&&<img class="chapter-art projects-art" src={projectsArtView.src} width={projectsArtView.attributes.width} height={projectsArtView.attributes.height} alt="" aria-hidden="true" loading="lazy" />}
    {section.id==='skills'&&<img class="chapter-art skills-art" src={skillsArtView.src} width={skillsArtView.attributes.width} height={skillsArtView.attributes.height} alt="" aria-hidden="true" loading="lazy" />}
    {section.id==='contato'&&<img class="chapter-art contact-art" src={contactArtView.src} width={contactArtView.attributes.width} height={contactArtView.attributes.height} alt="" aria-hidden="true" loading="lazy" />}
    {section.id==='sobre'&&<figure class="scene scene-environment train-environment about-backdrops" aria-hidden="true">
      <img class="is-active" data-story-backdrop="0" src={heroProfileView.src} width={heroProfileView.attributes.width} height={heroProfileView.attributes.height} alt="" />
      <img data-story-backdrop="1" src={trainView.src} width={trainView.attributes.width} height={trainView.attributes.height} alt="" loading="lazy" />
      <img data-story-backdrop="2" src={classroomView.src} width={classroomView.attributes.width} height={classroomView.attributes.height} alt="" loading="lazy" />
    </figure>}
    {section.id==='formacao'&&<figure class="scene scene-environment classroom-environment" aria-hidden="true">
      <img src={classroomView.src} width={classroomView.attributes.width} height={classroomView.attributes.height} alt="" loading="lazy" />
    </figure>}
    <h2 class="view-word" id={`${section.id}-title`} tabindex="-1">{section.name}</h2>
    <div class="view-body">

      {section.id==='sobre'&&<div class="about">
          <section class="about-story" aria-label="Retratos e trajetória" aria-roledescription="carrossel">
            <ol class="about-story-slides">
              <li class="about-story-slide" aria-label="1 de 3">
                <span class="about-story-index">01 / Quem eu sou</span><h3>Aprender.<br />Construir.<br />Refinar.</h3>
                <p>Sou Marcos Alexandre Bernardo. Estudo Desenvolvimento de Software Multiplataforma na FATEC São José dos Campos.</p>
                <a class="go" href="#projetos">Ver o que construí</a>
              </li>
              <li class="about-story-slide" aria-label="2 de 3" hidden>
                <span class="about-story-index">02 / Na prática</span><h3>Ideias ganham<br />forma quando<br />são testadas.</h3>
                <p>Nas APIs da FATEC, trabalhei com empresas parceiras externas. Administrei cerimônias Scrum, organizei backlogs e entregas de valor para nossos clientes.</p>
                <a class="go" href="#altave">Ver minhas contribuições</a>
              </li>
              <li class="about-story-slide" aria-label="3 de 3" hidden>
                <span class="about-story-index">03 / Próximo capítulo</span><h3>O Próximo<br />Passo.</h3>
                <p>Busco estágio na área de desenvolvimento de software e análise de dados para continuar meu crescimento profissional.</p>
                <a class="go" href="#contato">Vamos conversar</a>
              </li>
            </ol>
            <div class="about-story-controls"><button type="button" data-story-prev aria-label="Retrato anterior">←</button><span data-story-position aria-live="polite">01 / 03</span><button type="button" data-story-next aria-label="Próximo retrato">→</button></div>
          </section>
        <div class="about-facts"><div class="about-facts-intro"><h3></h3><p>Estudo DSM desde agosto de 2025. Os projetos integradores da FATEC me deram prática com clientes parceiros, organização ágil do trabalho e desenvolvimento em equipe. Busco estágio para continuar esse caminho.</p></div><dl class="ficha">
          <div><dt>Formação atual</dt><dd>Tecnólogo em Desenvolvimento de Software Multiplataforma<small>FATEC São José dos Campos – Prof. Jessen Vidal</small></dd></div>
          <div><dt>Período</dt><dd>Agosto de 2025 a dezembro de 2028</dd></div>
          <div><dt>Objetivo</dt><dd>Estágio, para levar a prática dos projetos a um contexto profissional</dd></div>
          <div><dt>Áreas de interesse</dt><dd><ul class="chips">{interests.map(interest=><li>{interest}</li>)}</ul></dd></div>
        </dl></div>
      </div>}

      {section.id==='projetos'&&<>
        <nav class="project-tabs" aria-label="Tipos de projeto"><a href="#api" class="tab-link" data-tab="api">API</a><a href="#profissionais" class="tab-link" data-tab="profissionais">Profissionais</a><a href="#pessoais" class="tab-link" data-tab="pessoais">Pessoais</a></nav>

        <div class="project-panel api" id="api">
          <h3 class="sr-only">Projetos acadêmicos API</h3>
          <p class="api-explainer">API (Aprendizagem por Projetos Integradores): projetos semestrais da FATEC em que alunos desenvolvem soluções para problemas reais, inclusive de clientes externos, com práticas do Scrum.</p>
          <nav class="project-index" aria-label="Escolher projeto API">{academicProjects.map((project,i)=><a href={`#${project.id}`} style={`--card:${i}`} data-tilt>
            <b aria-hidden="true">{project.numeral}</b><span>{project.term}<small>{project.partner}</small></span>
          </a>)}</nav>
          <div class="project-dossiers">{academicProjects.map(project=><article class="project-dossier" id={project.id} aria-labelledby={`${project.id}-title`}>
            <header class="dossier-head">
              <span class="dossier-numeral" aria-hidden="true">{project.numeral}</span>
              <div>
                <p class="dossier-term">{project.term} <i></i> {project.role}</p>
                <h3 class="bar" id={`${project.id}-title`} tabindex="-1">{project.title}</h3>
                <p class="dossier-partner"><span>{project.id==='scrum-academy'?'Cliente':'Empresa parceira'}</span>{project.partner}</p>
              </div>
            </header>
            <div class="case">
              <section class="case-problem"><h4>Situação-problema</h4><p>{project.problem}</p></section>
              <section class="case-solution"><h4>Solução desenvolvida pelo time</h4><p>{project.solution}</p></section>
            </div>
            <div class="dossier-detail">
              <section><h4>Minhas contribuições</h4><ul class="marks">{project.contributions.map(contribution=><li>{contribution}</li>)}</ul></section>
              <section>
                <h4>Tecnologias</h4><ul class="chips">{project.technologies.map(technology=><li>{technology}</li>)}</ul>
                <h4>Hard skills</h4><p>{project.technologies.join(', ')}.</p>
                <h4>Soft skills exercitadas</h4><ul class="chips">{project.softSkills.map(item=><li>{item}</li>)}</ul>
                <h4>Repositório</h4>
                <p><a class="go" href={project.teamRepo} target="_blank" rel="noopener noreferrer">Ver repositório do projeto<span class="sr-only"> (abre em nova aba)</span></a></p>
              </section>
            </div>
          </article>)}</div>
        </div>

        <div class="project-panel statement" id="profissionais">
          <h3>Em busca da primeira oportunidade de <span class="plate">estágio</span></h3>
          <div class="statement-copy">
            <p>Ainda não tenho vínculo formal de estágio ou CLT. Minha vivência prática vem dos projetos de API para clientes parceiros reais e dos projetos técnicos com foco em rastreabilidade, controle de acesso e auditoria.</p>
            <p>Este espaço receberá as experiências profissionais conforme acontecerem.</p>
            <p class="go-row"><a class="go" href="#api">Conhecer os projetos API</a><a class="go" href="#pessoais">Explorar os projetos técnicos</a></p>
          </div>
        </div>

        <div class="project-panel" id="pessoais">
          <h3 class="sr-only">Projetos pessoais e técnicos</h3>
          <ul class="quests">{personalProjects.map(project=><li><a href={`https://github.com/MarcosAlexandre-txt/${project.repo}`} target="_blank" rel="noopener noreferrer">
            <div class="quest-name"><h4>{project.name}</h4><p>{project.subtitle}</p></div>
            <div class="quest-detail"><p>{project.description}</p>{project.stack&&<ul class="chips">{project.stack.split(' · ').map(item=><li>{item}</li>)}</ul>}</div>
            <span class="go">Ver repositório<span class="sr-only"> (abre em nova aba)</span></span>
          </a></li>)}</ul>
        </div>
      </>}

      {section.id==='formacao'&&<div class="edu">
        <div class="edu-main">
          <div class="course">
            <h3 class="bar">Desenvolvimento de Software Multiplataforma</h3>
            <p class="course-kind">Tecnólogo <i></i> em curso</p>
            <p class="course-school">FATEC São José dos Campos – Prof. Jessen Vidal</p>
            <ol class="track" style={`--now:${now}`} aria-label="Semestres do curso, de agosto de 2025 a dezembro de 2028">{semesters.map((semester,i)=><li class:list={{done:i<now,now:i===now}} aria-current={i===now?'step':undefined}><span>{semester}</span>{i===now&&<em>agora</em>}</li>)}</ol>
            <p class="track-ends"><span>Agosto de 2025</span><span>Dezembro de 2028</span></p>
          </div>
          <h3 class="subhead">Certificações</h3>
          <ol class="certs">{certifications.map(cert=><li>
            <span class="cert-year">{cert.year}</span>
            <div><h4>{cert.name}</h4><p>{cert.issuer}</p><ul class="chips">{cert.topics.map(topic=><li>{topic}</li>)}</ul></div>
          </li>)}</ol>
        </div>
      </div>}

      {section.id==='skills'&&<div class="arcana-menu skill-console" data-arcana-menu data-card-art={cardArt.src}>
        <p class="skills-kicker">Observatório dos Arcanos · escolha uma carta e siga suas evidências</p>
        <div class="arcana-filters" role="group" aria-label="Tipo de competência">
          <button type="button" data-skill-filter="hard" aria-pressed="true">Hard skills</button>
          <button type="button" data-skill-filter="soft" aria-pressed="false">Soft skills</button>
        </div>
        <div class="skill-selection">
          <div class="skill-reading">
            <div class="skill-switcher">
              <button type="button" data-arcana-prev aria-label="Competência anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
              <span data-arcana-position aria-live="polite" aria-label="Posição no catálogo">1 de 23</span>
              <button type="button" data-arcana-next aria-label="Próxima competência"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
            </div>
            <div class="arcana-details">
              {skillArcanas.map((item,i)=><article class="arcana-detail" id={`skill-${i}`} data-skill-detail={i} data-kind={item.kind}>
                <h3>{item.name}</h3>
                <div class="skill-detail-copy">
                  {item.detail&&<p class="arcana-description">{item.detail}</p>}
                  {item.evidence.length>0?<><h4>Na prática</h4><ul class="arcana-evidence">{item.evidence.map(e=>{
                    const link=skillEvidenceLink(e);
                    return <li class:list={[{'has-evidence-link':Boolean(link)}]}>{link?<a class="skill-evidence-link" href={link.href} target={link.external?'_blank':undefined} rel={link.external?'noopener noreferrer':undefined} aria-label={`${e}: ${link.external?'abrir repositório em nova aba':'ver evidência no portfólio'}`}><span>{e}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.external?'M5 19 19 5M5 5h14v14':'M4 12h16m-6-6 6 6-6 6'}/></svg></a>:e}</li>;
                  })}</ul></>:item.kind==='hard'&&<p class="arcana-description">Potência sendo colocada em ato. Projetos a caminho.</p>}
                  {item.evidence.length===0&&<a class="go" href="#projetos">Explorar os projetos</a>}
                </div>
              </article>)}
            </div>
          </div>
          <div class="arcana-stage" data-arcana-stage data-face="front" role="group" aria-label="Baralho de competências. Clique para virar a carta; deslize para trocar.">
            <div class="arcana-webgl" data-arcana-webgl aria-hidden="true"></div>
            <div class="arcana-fallback" aria-hidden="true"><img src={cardFront(0)} width="848" height="1264" alt="" loading="lazy" decoding="async" /></div>
            <button type="button" class="card-flip" data-card-flip aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 8a8 8 0 0 0-14-2L3 9m0-5v5h5M5 16a8 8 0 0 0 14 2l2-3m0 5v-5h-5"/></svg><span data-flip-label>Virar carta</span></button>
            <span class="sr-only" role="status" data-card-status></span>
          </div>
        </div>
        <div class="skill-catalog-header"><p>Escolha uma competência</p><p class="deck-hint">Navegue com <kbd>←</kbd> <kbd>→</kbd></p></div>
        <div class="arcana-catalog" role="group" aria-label="Escolher competência">
          {skillArcanas.map((item,i)=><button type="button" data-skill-card={i} data-kind={item.kind} data-card-front={cardFront(i)} aria-controls={`skill-${i}`} aria-pressed={i===0?'true':'false'}><img src={cardThumbs[i].src} width={cardThumbs[i].attributes.width} height={cardThumbs[i].attributes.height} alt="" loading="lazy" decoding="async" /><span>{item.name}</span></button>)}
        </div>
      </div>}

      {section.id==='contato'&&<div class="contact">
        <h3 class="contact-lead">Aberto a oportunidades de <span class="plate">estágio</span></h3>
        <p class="contact-areas">Engenharia de Software, Análise de Dados, Segurança da Informação e DevOps.</p>
        <ul class="channels">{channels.map((channel,i)=><li style={`--item:${i}`}><a href={channel.href} target={channel.external?'_blank':undefined} rel={channel.external?'noopener noreferrer':undefined}>
          <span class="channel-name">{channel.name}</span><span class="channel-value">{channel.value}</span>{channel.external&&<span class="sr-only"> (abre em nova aba)</span>}
        </a></li>)}</ul>
        <footer class="credits"><h4>Créditos</h4><p>Água: <a href="https://commons.wikimedia.org/wiki/File:Snell%27s_window_edge.jpg">“Snell’s window edge.jpg”</a>, de Hellbus, Wikimedia Commons. Adaptação de cores sob <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>.</p><p>Estátuas: imagem fornecida pelo titular. Autoria e licença a confirmar antes da publicação.</p><p>Gravuras da abertura, Projetos, Skills e Contato, além dos retratos pictóricos: artes originais geradas por IA; processo e referências em design/source/oil-scenes-prompts.md.</p><p>Música: “Color Your Night”, de Persona 3 Reload. Arquivo fornecido pelo titular, que declarou autorização de uso. Crédito detalhado e termos de distribuição pendentes.</p><p>Verso do baralho: recriação gerada por IA inspirada na referência de Persona, não um arquivo original do jogo. Frentes: composição e desenhos abstratos autorais; marcas das tecnologias via Devicon (MIT), com direitos de marca de seus respectivos titulares.</p><p>Tipografia: Archivo e Anton — SIL Open Font License.</p></footer>
      </div>}
    </div>
  </section>)}
</div>
